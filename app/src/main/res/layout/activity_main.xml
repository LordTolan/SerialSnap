<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Solar Serial Collector" android:textSize="27sp" android:textStyle="bold" android:textColor="@color/navy" />
    <EditText android:id="@+id/siteName" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Customer or site name" android:inputType="textCapWords" android:singleLine="true" />
    <Spinner android:id="@+id/deviceType" android:layout_width="match_parent" android:layout_height="48dp" />
    <EditText android:id="@+id/locationNote" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Location (roof, array, row, position)" android:inputType="textCapSentences" android:singleLine="true" />
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="Scan the barcode or printed serial on each device label." android:textSize="15sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/scanButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Scan Device" />
        <Button android:id="@+id/manualButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Manual Add" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/exportButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Export CSV" />
        <Button android:id="@+id/clearButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Clear All" />
    </LinearLayout>
    <TextView android:id="@+id/count" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="0 devices" android:textStyle="bold" android:textSize="18sp" />
    <ListView android:id="@+id/serialList" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:dividerHeight="1dp" />
</LinearLayout>
